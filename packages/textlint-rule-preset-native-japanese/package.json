{
  "name": "textlint-rule-preset-native-japanese",
  "version": "0.1.0",
  "private": true,
  "description": "不適切な日本語を位置と修正案で指摘することを目指す開発中のtextlintプリセット",
  "type": "module",
  "exports": "./src/index.js",
  "files": [
    "src/*.js",
    "backend/pyproject.toml",
    "backend/uv.lock",
    "backend/src/native_japanese/**/*.py",
    "backend/src/native_japanese/data/*.json",
    "assets",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "scripts": {
    "prepack": "node ../../tools/prepare-npm-package.js"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "dependencies": {
    "@dataiku/uv": "0.12.0",
    "env-paths": "4.0.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "signal-exit": "4.1.0"
  },
  "peerDependencies": {
    "textlint": ">=15.0.0"
  }
}
