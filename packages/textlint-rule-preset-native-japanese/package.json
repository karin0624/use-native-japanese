{
  "name": "textlint-rule-preset-native-japanese",
  "version": "0.1.0",
  "private": true,
  "description": "日本語の語の組み合わせを用例に照らして検査するtextlintプリセット",
  "type": "module",
  "exports": "./src/index.js",
  "files": [
    "src/*.js",
    "backend/pyproject.toml",
    "backend/uv.lock",
    "backend/vendor/ginza/*.whl",
    "backend/src/native_japanese/**/*.py",
    "backend/src/native_japanese/data/*.json",
    "assets",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "scripts": {
    "prepack": "node ../../tools/prepare-npm-package.js"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "dependencies": {
    "@dataiku/uv": "0.12.0",
    "env-paths": "4.0.0",
    "micromark": "4.0.3",
    "signal-exit": "4.1.0",
    "textlint-util-to-string": "3.3.4"
  },
  "peerDependencies": {
    "textlint": ">=15.0.0"
  }
}
