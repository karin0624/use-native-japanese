diff --git a/dict/Makefile.am b/dict/Makefile.am
index 0cf9b29..6072a50 100644
--- a/dict/Makefile.am
+++ b/dict/Makefile.am
@@ -1,4 +1,13 @@
-SUBDIRS = src scode ebcf gcf auto synonym distsim
+SUBDIRS = $(minimal_dict_subdirs)
+
+if MINIMAL_DPND
+# 初期化が全モードで読む実在の小資源を配置する。
+minimal_dict_subdirs = src scode gcf auto
